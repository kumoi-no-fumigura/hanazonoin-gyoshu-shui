 "poems": [
  {
   "seq": "1",
   "text": "山ふかみ霞のそこのあさぼらけみやこの春をふもとにぞみる",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "霞にほふ夕日の空はのどかにて雲にいろある山の端の松",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "みどりこき霞のしたの山の端にうすき柳の色ぞこもれる",
   "kana": "",
   "speaker": "",
   "page": 191,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "ふけぬるか霞にしづむ月影のそこともみえでかたぶきにけり",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "故郷の淺茅が庭のさくら花あたらさかりとみる人やなき",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "そことなき霞の底にかたぶきて花にかげもるありあけの月",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "あだなれど咲き散るほどはあるものをとはれぬ花や猶恨むらむ",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "春うとき深山がくれのながめゆゑとふべき花の頃も忘れて",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "梢より落ちくる花ものどかにて霞におもきいりあひの鐘",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "やぶしわかぬ春とやなれも花の咲くその名もしらぬ山の下草",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "花鳥の春におくるるなぐさめにまづまちすさぶ山郭公",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "あしびきの山ほととぎすなれを待つ里をばかれずこととひやせぬ",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "蘆しげる入江のみづのくらき夜におのれまがはずとぶ螢かな",
   "kana": "",
   "speaker": "",
   "page": 192,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "夏山のしげきみどりをへだてにて照る日およばぬかげぞ凉しき",
   "kana": "",
   "speaker": "",
   "page": 193,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "ともしする今だにくらき夏山にまよはむ後の闇はしらずや",
   "kana": "",
   "speaker": "",
   "page": 193,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "葵草かざすや今日の神まつりたてし使もおもかげに見ゆ",
   "kana": "",
   "speaker": "",
   "page": 193,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "夕立の雲とびわくる白鷺のつばさにかけて晴るる日のかげ",
   "kana": "",
   "speaker": "",
   "page": 193,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "空はれて梢いろこき月の夜の風におどろくせみのひと聲",
   "kana": "",
   "speaker": "",
   "page": 193,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "夕日さす田の面の稻葉末遠みなびきも果てずよわる秋風",
   "kana": "",
   "speaker": "集",
   "page": 193,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "吹きうつりなびく薄の末末を長閑にわたる野邊のゆふ風",
   "kana": "",
   "speaker": "",
   "page": 193,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "雲遠き夕日のあとの山際にゆくともみえぬ雁のひとつら",
   "kana": "",
   "speaker": "",
   "page": 193,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "暮れもあへず今さしのぼる山の端の月のこなたの松の一本",
   "kana": "",
   "speaker": "",
   "page": 193,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "我が心すめるばかりに更けはてて月を忘れて向ふよの月",
   "kana": "",
   "speaker": "",
   "page": 193,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "み山いでし秋の旅ねの夜ごろへて宿もる月や主人まつらむ",
   "kana": "",
   "speaker": "",
   "page": 193,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "風になびく尾花が末にかげろひて月遠くなる有明の庭",
   "kana": "",
   "speaker": "",
   "page": 193,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "吳竹のめぐれるさとを麓にて煙にまじるやまのもみぢ葉",
   "kana": "",
   "speaker": "",
   "page": 194,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "霧はるる田の面の末に山みえて稻葉につづく木木のもみぢ葉",
   "kana": "",
   "speaker": "",
   "page": 194,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "村時雨くも吹きはらふ朝風に木木のこのはぞ降りかはりぬる",
   "kana": "",
   "speaker": "",
   "page": 194,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "暮れやらぬ庭の光は雪にして奧くらくなる埋火のもと",
   "kana": "",
   "speaker": "",
   "page": 194,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "おきて見る朝けの軒端しも白しおとせぬ風は身にさむくして",
   "kana": "",
   "speaker": "",
   "page": 194,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "冬枯の木の葉さはらぬ高嶺よりこほりて出づる月ぞまぢかき",
   "kana": "",
   "speaker": "",
   "page": 194,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "ふりをやむ雲間の夕日やまはれて雪やいただく松のかずかず",
   "kana": "",
   "speaker": "",
   "page": 194,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "うちつけに哀なるこそあはれなれ契ならではかくやと思へば",
   "kana": "",
   "speaker": "",
   "page": 194,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "更けぬなり又とはれてと向ふ夜の涙に匂ふともし火の影",
   "kana": "",
   "speaker": "",
   "page": 194,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "人よまして心の底のあはれをば我れにて知らぬ奧も殘るを",
   "kana": "",
   "speaker": "",
   "page": 194,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "うきながらさすがに絕えぬ契をば猶もあはれになしこそはせめ",
   "kana": "",
   "speaker": "",
   "page": 194,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "常はただ獨ながめて大方の人にさへこそうとくなりゆけ",
   "kana": "",
   "speaker": "",
   "page": 194,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "さらばとて賴むになれば人心およばぬ際のおほくもあるかな",
   "kana": "",
   "speaker": "",
   "page": 194,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "戀ひあまるながめを人は知りもせじ我れとそめなす雲の夕暮",
   "kana": "",
   "speaker": "",
   "page": 195,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "聞きそふる昨日に今日のうきふしに覺めぬ哀もあやにくにして",
   "kana": "",
   "speaker": "",
   "page": 195,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "そことなき恨ぞ常に思ほゆるいかにぞ人のあらずなる頃",
   "kana": "",
   "speaker": "",
   "page": 195,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "かはりたつすべて恨のその上に憂さ哀さはかりのふしぶし",
   "kana": "",
   "speaker": "",
   "page": 195,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "人こそあれ我れさへしひて忘れなば名殘なからむそれも悲しき",
   "kana": "",
   "speaker": "",
   "page": 195,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "人しれず我れのみ弱き哀かなこの一節ぞかぎりとおもふに",
   "kana": "",
   "speaker": "",
   "page": 195,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "引くかたの心にまけて賴むかなしらぬ契のよよのかねごと",
   "kana": "",
   "speaker": "",
   "page": 195,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "おのづから人まありともつげてまし誠に通ふこころと思はば",
   "kana": "",
   "speaker": "新",
   "page": 195,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "ありし世の契よせめて夢ならばおもひねをだに待たまし物を",
   "kana": "",
   "speaker": "",
   "page": 195,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "我が袖の涙にやどる夜はの月おなじ影をも人やいとはむ",
   "kana": "",
   "speaker": "",
   "page": 195,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "待たぬよも猶いねがての槇の戶に音する風や吹きもやまなむ",
   "kana": "",
   "speaker": "",
   "page": 195,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "あはれをもかはさぬ君がながめには夕の雲もなにとかは見む",
   "kana": "",
   "speaker": "",
   "page": 195,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "雲霧にわけいる谷は末くれて夕日のこれる峯のかけはし",
   "kana": "",
   "speaker": "",
   "page": 195,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "人も身も又こむ春も知らぬ世に霞む雲路をへだてずもがな",
   "kana": "",
   "speaker": "",
   "page": 196,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "雲ふかきみどりの洞にすむ月のうき世の中にかげはたえにき",
   "kana": "",
   "speaker": "",
   "page": 196,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "羽音して渡る鳥のひとこゑに軒端のそらは雲あけぬなり",
   "kana": "",
   "speaker": "",
   "page": 196,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "跡たえてへだつる山の雲深しゆききは近きみやこなれども",
   "kana": "",
   "speaker": "",
   "page": 196,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "里里の明けゆくおとは急げども長閑にしらむ山のはの空",
   "kana": "",
   "speaker": "",
   "page": 196,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "もとよりのさながら夢とみる上はよしや必ずさめも覺めずも",
   "kana": "",
   "speaker": "",
   "page": 196,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "あともなき賤が家居の竹の垣犬のこゑのみおくぶかくして",
   "kana": "",
   "speaker": "",
   "page": 196,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "の葉に色はなけれど思ひやる心を添へてあはれとや見る",
   "kana": "",
   "speaker": "",
   "page": 196,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "に近き人のあはれにおどろけば世の理ぞさらに悲しき",
   "kana": "",
   "speaker": "",
   "page": 196,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "燕なく軒端の夕日かげきえて柳にあをきにはのはるかぜ",
   "kana": "",
   "speaker": "",
   "page": 197,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "誰れも皆あたら色香をながむらし昨日も同じ花鳥のはる",
   "kana": "",
   "speaker": "",
   "page": 197,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "窓の外にしたたる雨を聞くなべにかべに背けるよはの燈火",
   "kana": "",
   "speaker": "",
   "page": 197,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "立田川もみぢ葉ながるみよし野のよしのの山に櫻はなさく",
   "kana": "",
   "speaker": "",
   "page": 197,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "さゆる夜の空高くすむ月よりも置きそふ霜の色はすさまじ",
   "kana": "",
   "speaker": "",
   "page": 197,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "世をてらす光をいかでかかげましけなばけぬべき法の燈火",
   "kana": "",
   "speaker": "",
   "page": 197,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "神風にみだれし塵もをさまりぬ天照す日のあきらけき世は",
   "kana": "",
   "speaker": "",
   "page": 197,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "雲をふむ峯のかけはしそれよりもうき世をわたる道ぞあやふき",
   "kana": "",
   "speaker": "載",
   "page": 197,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "水上の定めし末はたえもせずみもすそ河のひとつ流に",
   "kana": "",
   "speaker": "",
   "page": 197,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "葦原やみだれし國の風をかへて民の草葉もいまなびくなり",
   "kana": "",
   "speaker": "",
   "page": 197,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "葦原やただしき國の風として大和ことの葉すゑもみだれず",
   "kana": "",
   "speaker": "",
   "page": 197,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "ちはやぶる神のたもてる我が國の天つ日嗣は今もたえせず",
   "kana": "",
   "speaker": "",
   "page": 198,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "誓ひおきし心のすゑの違はずば神と人との道もみだれじ",
   "kana": "",
   "speaker": "",
   "page": 198,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "僞りてかすむる道をあきらけき神の心にゆるししもせじ",
   "kana": "",
   "speaker": "",
   "page": 198,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "世の爲におもふ心はおしむけぬ棄てむすてじは神のまにまに",
   "kana": "",
   "speaker": "",
   "page": 198,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "あはれ人わがわたくしを棄てねかし世をしか住めば神もなやまむ",
   "kana": "",
   "speaker": "",
   "page": 198,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "世の中に僞る道のたつならば正しき神をたれか仰がむ",
   "kana": "",
   "speaker": "",
   "page": 198,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "つくりなす人の力は强くとも弱きまことを神し加へよ",
   "kana": "",
   "speaker": "",
   "page": 198,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "あぢきなく世を思ふとて身をぞなやむ身をば安くて過ぎぬべき世に",
   "kana": "",
   "speaker": "",
   "page": 198,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "すたれこし道を今までおこしつる誠はすてじすみよしの神",
   "kana": "",
   "speaker": "",
   "page": 198,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "賴もしみ仰ぎぞいのる敷島の道をすてずばわれを棄てめや",
   "kana": "",
   "speaker": "",
   "page": 198,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "今更にわが私をいのらめや世にあれば世を思ふばかりぞ",
   "kana": "",
   "speaker": "",
   "page": 198,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "よこさまの道をしとめよ神の心ただしかれとて世をしまもらば",
   "kana": "",
   "speaker": "",
   "page": 198,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "いやましに亂れぞゆかむ神だにも正しき道を守りたてずば",
   "kana": "",
   "speaker": "",
   "page": 198,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "僞りてかすむる道のたつならば人も人にて世も世ならめや",
   "kana": "",
   "speaker": "",
   "page": 198,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "正しきとまがれるとわく道なくばかすむるままに世は亂れなむ",
   "kana": "",
   "speaker": "",
   "page": 198,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
